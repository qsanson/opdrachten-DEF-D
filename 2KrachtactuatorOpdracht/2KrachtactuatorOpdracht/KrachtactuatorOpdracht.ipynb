    "N = 64\n",
    "L_draad = 0.1\n",
    "dl=np.array([0, 0, L_draad/N])\n",
    "r_veld = np.array([0.1, 0, 0])\n",
    "\n",
    "#als we alle stukjes willen optellen van dH moeten we r_bron langs de hele draad laten lopen. dat doen we hier.\n",
    "z_waarden_r_bron = np.linspace(-L_draad/2, L_draad/2, N)\n",
    "r_bron = np.zeros((N, 3))\n",
    "r_bron[:, 2] = z_waarden_r_bron\n",
    "\n",
    "#verschil array maken voor berekening dH\n",
    "verschil_array = r_veld - r_bron\n",
    "\n",
    "#weer dH in drieen splitsen\n",
    "alpha = (1/(4*np.pi))*I\n",
    "beta = np.cross(dl, verschil_array)\n",
    "gamma = np.sqrt(verschil_array[:, 0]**2 + verschil_array[:, 1]**2 + verschil_array[:, 2]**2)**3\n",
    "\n",
    "#array maken met alle stukjes dH. gamma moet opnieuw geformat worden omdat python anders boos wordt\n",
    "dH_array = alpha*(beta/gamma[:, np.newaxis])\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(z_waarden_r_bron, dH_array[:, 1], label='dH_y')\n",
    "plt.title('grootte van dH naast de draad')\n",
    "plt.xlabel('z_bron (m)')\n",
    "plt.ylabel('grootte dH (A/m)')\n",
    "plt.grid()\n",
    "\n",
    "H_numeriek = np.sum(dH_array, axis=0)\n",
    "\n",
    "#berekenen van analytisch veld\n",
    "H_analytisch = I/2*np.pi*0.1\n",
