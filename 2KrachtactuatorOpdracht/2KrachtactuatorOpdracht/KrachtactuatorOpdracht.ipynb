   "source": [
    "# --- Opdracht 14: Numeriek vs Analytisch H-veld ---\n",
    "\n",
    "# 1. Instellingen\n",
    "I_idee2 = 180         # De stroom van je werkende ontwerp\n",
    "r_field = np.array([0, 0, 0])  # We meten precies in het midden (oorsprong)\n",
    "\n",
    "# 2. Analytisch antwoord (oneindig lange solenoide)\n",
    "# H = n * I, waarbij n de spoed is (N/L)\n",
    "n_spoed = N_wikkelingen / L_sol\n",
    "H_analytisch = n_spoed * I_idee2\n",
    "print(f\"Analytisch H-veld (oneindig): {H_analytisch:.2f} A/m\")\n",
    "\n",
    "# 3. Numerieke berekening (Biot-Savart)\n",
    "def bereken_totaal_H_veld(x, y, z, I):\n",
    "    H_totaal = np.array([0.0, 0.0, 0.0])\n",
    "    \n",
    "    # We lopen over de segmenten van de draad\n",
    "    # d_l is het vectorverschil tussen punt i+1 en punt i\n",
    "    for i in range(len(x) - 1):\n",
    "        r_source = np.array([x[i], y[i], z[i]])\n",
    "        dl = np.array([x[i+1]-x[i], y[i+1]-y[i], z[i+1]-z[i]])\n",
    "        \n",
    "        # Roep je functie uit Opdracht 11 aan\n",
    "        # Let op: de functie berekent dH, we moeten dit vermenigvuldigen met I\n",
    "        dH = field_current_element(r_field, r_source, dl)\n",
    "        H_totaal += I * dH\n",
    "        \n",
    "    return H_totaal\n",
    "\n",
    "# Berekening uitvoeren\n",
    "H_numeriek = bereken_totaal_H_veld(x, y, z, I_idee2)\n",
    "\n",
    "print(f\"Numeriek H-veld (midden spoel): {H_numeriek[2]:.2f} A/m (z-component)\")\n",
    "print(f\"Verschil: {abs(H_analytisch - H_numeriek[2]):.2f} A/m\")\n",
    "\n",
    "# Verhouding\n",
    "verhouding = (H_numeriek[2] / H_analytisch) * 100\n",
    "print(f\"De numerieke waarde is {verhouding:.2f}% van de analytische waarde.\")"
   ]
  },
