    "### BEGIN SOLUTION\n",
    "def aantal_wikkelingen(L_s, I, F, d_draad, max_L,):\n",
    "    N_min = ((L_s/I)*np.sqrt((2*F)/(mu_0*(mu_r-1)*A_plunjer)))\n",
    "\n",
    "    N_max_1 = L_s/d_draad\n",
    "\n",
    "    N_max_2 = max_L/(2*np.pi*R_actuator)\n",
    "\n",
    "    N_max = min(N_max_1,N_max_2)\n",
    "\n",
    "    if N_min > N_max: ## Als het ontwerp niet mogelijk is.\n",
    "        #print('The design with %.1f unit has no workable solution'%1)\n",
    "        N_min = 'NaN'\n",
    "        N_max = 'NaN'\n",
    "   \n",
    "    return N_min, N_max\n",
    "\n",
    "\n"
   ]
